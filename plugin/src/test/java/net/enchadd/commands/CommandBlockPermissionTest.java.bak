package net.enchadd.commands;

import org.bukkit.command.CommandSender;
import org.bukkit.plugin.Plugin;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Nested;
import org.junit.jupiter.api.Test;
import org.mockbukkit.mockbukkit.MockBukkit;
import org.mockbukkit.mockbukkit.ServerMock;
import org.mockbukkit.mockbukkit.entity.PlayerMock;

import java.util.UUID;

import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;

/**
 * Command Block Permission Test
 *
 * Verifies that command blocks are handled correctly with respect to permissions.
 * In Minecraft, command blocks by default bypass certain permission checks unless
 * explicitly configured. This test ensures the plugin correctly handles command
 * block senders.
 */
@DisplayName("Command Block Permission Tests")
class CommandBlockPermissionTest {

    private ServerMock server;
    private Plugin plugin;

    @BeforeEach
    void setUp() {
        server = MockBukkit.mock();
        plugin = MockBukkit.mock(Plugin.class);
        MockBukkit.when(plugin.isEnabled()).thenReturn(true);
        MockBukkit.when(plugin.getName()).thenReturn("enchadd-test");
    }

    @AfterEach
    void tearDown() {
        MockBukkit.unmock();
    }

    @Nested
    @DisplayName("EnchantListPermissionSupport Tests")
    class PermissionSupportTests {

        private EnchantListPermissionSupport permissionSupport;

        @BeforeEach
        void setUp() {
            permissionSupport = new EnchantListPermissionSupport();
        }

        @Test
        @DisplayName("Player with permission should be allowed")
        void playerWithPermission_shouldBeAllowed() {
            PlayerMock player = server.createPlayer("TestPlayer", UUID.randomUUID());

            // Grant the permission
            player.addAttachment(plugin, EnchantListCommand.PERM_LIST, true);

            boolean result = permissionSupport.hasPermission(player, EnchantListCommand.PERM_LIST);
            assertTrue(result, "Player with permission should be allowed");
        }

        @Test
        @DisplayName("Player without permission should be denied")
        void playerWithoutPermission_shouldBeDenied() {
            PlayerMock player = server.createPlayer("NoPermPlayer", UUID.randomUUID());

            // Do not grant the permission
            boolean result = permissionSupport.hasPermission(player, EnchantListCommand.PERM_LIST);
            assertFalse(result, "Player without permission should be denied");
        }

        @Test
        @DisplayName("Player without permission should receive no_permission message")
        void playerWithoutPermission_shouldReceiveMessage() {
            PlayerMock player = server.createPlayer("MessageTestPlayer", UUID.randomUUID());
            int initialMessages = server.getSentMessages().size();

            permissionSupport.hasPermission(player, EnchantListCommand.PERM_LIST);

            assertTrue(server.getSentMessages().size() > initialMessages,
                    "Player without permission should receive a message");
        }

        @Test
        @DisplayName("Command block sender should bypass player permission check")
        void commandBlock_shouldBypassPermission() {
            // Get the console command sender (which is similar to command block behavior)
            CommandSender console = server.getConsoleSender();

            // Console/Command block senders should always be allowed
            boolean result = permissionSupport.hasPermission(console, "any.permission.node");
            assertTrue(result, "Console/Command block sender should bypass permission check");
        }

        @Test
        @DisplayName("Console should bypass permission regardless of permission status")
        void console_shouldBypassPermissionRegardlessOfStatus() {
            CommandSender console = server.getConsoleSender();

            // Even with non-existent permissions, console should be allowed
            boolean result = permissionSupport.hasPermission(console, "nonexistent.permission");
            assertTrue(result, "Console should bypass all permission checks");
        }

        @Test
        @DisplayName("evaluate() static method should return correct values for non-players")
        void evaluate_shouldReturnCorrectValuesForNonPlayers() {
            // When playerSender is false (console/command block), always return true
            assertTrue(EnchantListPermissionSupport.evaluate(false, false),
                    "Non-player sender should always be allowed even without permission");
            assertTrue(EnchantListPermissionSupport.evaluate(false, true),
                    "Non-player sender should be allowed with permission");
        }

        @Test
        @DisplayName("evaluate() static method should respect player permissions")
        void evaluate_shouldRespectPlayerPermissions() {
            // When playerSender is true, respect the permission
            assertFalse(EnchantListPermissionSupport.evaluate(true, false),
                    "Player without permission should be denied");
            assertTrue(EnchantListPermissionSupport.evaluate(true, true),
                    "Player with permission should be allowed");
        }
    }

    @Nested
    @DisplayName("EnchantListCommandSupport Integration Tests")
    class CommandSupportIntegrationTests {

        private EnchantListCommandSupport commandSupport;

        @BeforeEach
        void setUp() {
            commandSupport = new EnchantListCommandSupport(plugin);
        }

        @Test
        @DisplayName("Player with list permission should pass hasListPermission")
        void playerWithListPermission_shouldPass() {
            PlayerMock player = server.createPlayer("ListPlayer", UUID.randomUUID());
            player.addAttachment(plugin, EnchantListCommand.PERM_LIST, true);

            assertTrue(commandSupport.hasListPermission(player),
                    "Player with list permission should pass");
        }

        @Test
        @DisplayName("Player without list permission should fail hasListPermission")
        void playerWithoutListPermission_shouldFail() {
            PlayerMock player = server.createPlayer("NoListPlayer", UUID.randomUUID());

            assertFalse(commandSupport.hasListPermission(player),
                    "Player without list permission should fail");
        }

        @Test
        @DisplayName("Console should pass list permission check")
        void console_shouldPassListPermission() {
            CommandSender console = server.getConsoleSender();

            assertTrue(commandSupport.hasListPermission(console),
                    "Console should pass list permission check");
        }

        @Test
        @DisplayName("Player with export permission should pass hasExportPermission")
        void playerWithExportPermission_shouldPass() {
            PlayerMock player = server.createPlayer("ExportPlayer", UUID.randomUUID());
            player.addAttachment(plugin, EnchantListCommand.PERM_EXPORT, true);

            assertTrue(commandSupport.hasExportPermission(player),
                    "Player with export permission should pass");
        }

        @Test
        @DisplayName("Player without export permission should fail hasExportPermission")
        void playerWithoutExportPermission_shouldFail() {
            PlayerMock player = server.createPlayer("NoExportPlayer", UUID.randomUUID());

            assertFalse(commandSupport.hasExportPermission(player),
                    "Player without export permission should fail");
        }

        @Test
        @DisplayName("Console should pass export permission check")
        void console_shouldPassExportPermission() {
            CommandSender console = server.getConsoleSender();

            assertTrue(commandSupport.hasExportPermission(console),
                    "Console should pass export permission check");
        }

        @Test
        @DisplayName("Player with admin permission should pass hasAdminPermission")
        void playerWithAdminPermission_shouldPass() {
            PlayerMock player = server.createPlayer("AdminPlayer", UUID.randomUUID());
            player.addAttachment(plugin, EnchantListCommand.PERM_ADMIN, true);

            assertTrue(commandSupport.hasAdminPermission(player),
                    "Player with admin permission should pass");
        }

        @Test
        @DisplayName("Player without admin permission should fail hasAdminPermission")
        void playerWithoutAdminPermission_shouldFail() {
            PlayerMock player = server.createPlayer("NoAdminPlayer", UUID.randomUUID());

            assertFalse(commandSupport.hasAdminPermission(player),
                    "Player without admin permission should fail");
        }

        @Test
        @DisplayName("Console should pass all permission checks")
        void console_shouldPassAllPermissionChecks() {
            CommandSender console = server.getConsoleSender();

            assertTrue(commandSupport.hasListPermission(console),
                    "Console should pass list permission");
            assertTrue(commandSupport.hasExportPermission(console),
                    "Console should pass export permission");
            assertTrue(commandSupport.hasAdminPermission(console),
                    "Console should pass admin permission");
            assertTrue(commandSupport.hasInfoPermission(console),
                    "Console should pass info permission");
        }

        @Test
        @DisplayName("Console should bypass admin-only commands")
        void console_shouldBypassAdminCommands() {
            CommandSender console = server.getConsoleSender();

            // Admin commands should work for console
            assertTrue(commandSupport.hasAdminPermission(console),
                    "Console should have admin permission bypass");
        }
    }

    @Nested
    @DisplayName("Permission Node Constants Tests")
    class PermissionConstantsTests {

        @Test
        @DisplayName("Permission constants should be correctly defined")
        void permissionConstants_shouldBeCorrect() {
            assertTrue(EnchantListCommand.PERM_LIST.contains("enchadd."),
                    "List permission should start with 'enchadd.'");
            assertTrue(EnchantListCommand.PERM_INFO.contains("enchadd."),
                    "Info permission should start with 'enchadd.'");
            assertTrue(EnchantListCommand.PERM_EXPORT.contains("enchadd."),
                    "Export permission should start with 'enchadd.'");
            assertTrue(EnchantListCommand.PERM_ADMIN.contains("enchadd."),
                    "Admin permission should start with 'enchadd.'");
        }

        @Test
        @DisplayName("Permission constants should have correct suffixes")
        void permissionConstants_shouldHaveCorrectSuffixes() {
            assertTrue(EnchantListCommand.PERM_LIST.endsWith("list"),
                    "List permission should end with 'list'");
            assertTrue(EnchantListCommand.PERM_INFO.endsWith("info"),
                    "Info permission should end with 'info'");
            assertTrue(EnchantListCommand.PERM_EXPORT.endsWith("export"),
                    "Export permission should end with 'export'");
            assertTrue(EnchantListCommand.PERM_ADMIN.endsWith("admin"),
                    "Admin permission should end with 'admin'");
        }

        @Test
        @DisplayName("All permission constants should be unique")
        void permissionConstants_shouldBeUnique() {
            assertTrue(!EnchantListCommand.PERM_LIST.equals(EnchantListCommand.PERM_INFO),
                    "List and info permissions should be different");
            assertTrue(!EnchantListCommand.PERM_LIST.equals(EnchantListCommand.PERM_EXPORT),
                    "List and export permissions should be different");
            assertTrue(!EnchantListCommand.PERM_LIST.equals(EnchantListCommand.PERM_ADMIN),
                    "List and admin permissions should be different");
            assertTrue(!EnchantListCommand.PERM_INFO.equals(EnchantListCommand.PERM_EXPORT),
                    "Info and export permissions should be different");
            assertTrue(!EnchantListCommand.PERM_INFO.equals(EnchantListCommand.PERM_ADMIN),
                    "Info and admin permissions should be different");
            assertTrue(!EnchantListCommand.PERM_EXPORT.equals(EnchantListCommand.PERM_ADMIN),
                    "Export and admin permissions should be different");
        }
    }
}
